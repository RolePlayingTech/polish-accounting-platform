# Opcjonalne: tylko polecenia DB; pnpm dev nie wymaga tego pliku ani PostgreSQL.
# Zastąp placeholder hasłem dedykowanego konta; nie commituj .env ani jego zawartości.
PAP_DATABASE_ENV=local
DATABASE_URL=postgres://pap_local:UZUPELNIJ_HASLO_LOCAL@127.0.0.1:5432/pap_local

# Testy integracyjne używają osobnej, syntetycznej bazy pap_test.
# PAP_DATABASE_ENV=test
# DATABASE_URL=postgres://pap_test:UZUPELNIJ_HASLO_TEST@127.0.0.1:5432/pap_test

# Opcjonalne: serwerowa weryfikacja tokenów OIDC (6D-2); pnpm dev i testy nie wymagają zewnętrznego IdP.
# PAP_OIDC_ENV=local
# PAP_OIDC_ISSUER=http://127.0.0.1:8080/realms/pap
# PAP_OIDC_JWKS_URI=http://127.0.0.1:8080/realms/pap/protocol/openid-connect/certs
# PAP_OIDC_AUDIENCE=pap-api
# PAP_OIDC_ALLOWED_ALGS=RS256,ES256
# PAP_OIDC_ALLOWED_AZP=pap-web-client
# PAP_OIDC_REQUIRED_SCOPES=openid,pap:accounting
# PAP_OIDC_CLOCK_TOLERANCE_SECONDS=30
# PAP_OIDC_MAX_TOKEN_AGE_SECONDS=900
