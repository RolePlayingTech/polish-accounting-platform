{
  "name": "@pap/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-fastify": "12.2.0",
    "@pap/application": "workspace:*",
    "@pap/contracts": "workspace:*",
    "fastify": "5.12.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:container": "tsx watch src/main.ts",
    "build": "tsc -b",
    "start": "node dist/main.js",
    "lint": "eslint src test",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config ../../vitest.config.ts",
    "clean": "node -e \"import('node:fs').then(({ rmSync }) => rmSync('dist', { recursive: true, force: true }))\""
  }
}
