{
  "name": "@pap/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-fastify": "12.2.0",
    "@pap/application": "workspace:*",
    "@pap/contracts": "workspace:*",
    "@pap/db": "workspace:*",
    "@pap/domain": "workspace:*",
    "@pap/mcp": "workspace:*",
    "fastify": "5.12.7",
    "jose": "6.2.13",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:container": "tsx watch src/main.ts",
    "build": "tsc -b",
    "start": "node dist/main.js",
    "lint": "eslint src test vitest.integration.config.ts vitest.adversarial.config.ts",
    "typecheck": "tsc -b --pretty false && tsc -p test/tsconfig.json --pretty false",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:adversarial": "vitest run --config vitest.adversarial.config.ts",
    "clean": "node -e \"import('node:fs').then(({ rmSync }) => rmSync('dist', { recursive: true, force: true }))\""
  }
}
