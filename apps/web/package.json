{
  "name": "@pap/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@pap/contracts": "workspace:*",
    "@pap/ui": "workspace:*",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:container": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint app lib test e2e",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts",
    "clean": "node -e \"import('node:fs').then(({ rmSync }) => rmSync('.next', { recursive: true, force: true }))\""
  }
}
