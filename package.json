{
  "name": "polish-accounting-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=12.15.0 <13"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@pap/web",
    "dev:container": "turbo run dev:container --filter=@pap/web",
    "dev:mcp": "pnpm --filter @pap/mcp dev",
    "build": "turbo run build",
    "lint": "turbo run lint && eslint playwright.config.ts playwright.oidc.config.ts test",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm test:arch",
    "test:integration": "pnpm --filter @pap/db test:integration",
    "test:integration:db": "pnpm --filter @pap/db test:integration",
    "test:integration:api": "pnpm --filter @pap/api test:integration",
    "test:integration:all": "pnpm --filter @pap/db test:integration && pnpm --filter @pap/api test:integration",
    "test:adversarial": "pnpm --filter @pap/api test:adversarial",
    "qa:preflight": "node scripts/qa/preflight.mjs",
    "test:arch": "vitest run --config vitest.config.ts test/architecture-boundaries.test.ts",
    "db:generate": "pnpm --filter @pap/db db:generate",
    "db:migrate": "pnpm --filter @pap/db db:migrate",
    "test:e2e": "turbo run build && playwright test",
    "test:e2e:oidc": "turbo run build && playwright test --config playwright.oidc.config.ts",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,json,css,mjs}\" \"!apps/**/next-env.d.ts\" \"packages/**/*.{ts,tsx,json,css,mjs}\" \"test/**/*.{ts,tsx,json,mjs}\" \"*.json\" \"*.mjs\" \"*.yaml\" \"playwright.config.ts\" \"playwright.oidc.config.ts\" \"pnpm-lock.yaml\" \".github/workflows/ci.yml\"",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@agentclientprotocol/codex-acp": "^2.5.0",
    "@e2e-dev/acp": "^0.1.1",
    "@e2e-dev/web": "^0.15.5",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "e2e": "^0.23.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
