{
  "name": "@pap/application",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp-gateway": {
      "types": "./dist/mcp-gateway.d.ts",
      "import": "./dist/mcp-gateway.js"
    },
    "./notifications-engine": {
      "types": "./dist/notifications-engine.d.ts",
      "import": "./dist/notifications-engine.js"
    },
    "./accounting-workspace": {
      "types": "./dist/accounting-workspace.d.ts",
      "import": "./dist/accounting-workspace.js"
    },
    "./demo-seed": {
      "types": "./dist/demo-seed.d.ts",
      "import": "./dist/demo-seed.js"
    }
  },
  "dependencies": {
    "@pap/contracts": "workspace:*",
    "@pap/domain": "workspace:*"
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint src test",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config ../../vitest.config.ts",
    "clean": "node -e \"import('node:fs').then(({ rmSync }) => rmSync('dist', { recursive: true, force: true }))\""
  }
}
