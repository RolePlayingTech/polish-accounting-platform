{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@pap/web#dev": {
      "with": ["@pap/api#dev"],
      "cache": false,
      "persistent": true
    },
    "dev:container": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@pap/web#dev:container": {
      "with": ["@pap/api#dev:container"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
